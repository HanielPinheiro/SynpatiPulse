<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ArduinoController\**" />
    <Compile Remove="Arduino\**" />
    <EmbeddedResource Remove="ArduinoController\**" />
    <EmbeddedResource Remove="Arduino\**" />
    <None Remove="ArduinoController\**" />
    <None Remove="Arduino\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Forms\BrainStimulator_Bkp.cs" />
    <Compile Remove="Forms\BrainStimulator_Bkp.Designer.cs" />
    <Compile Remove="Forms\Interface.cs" />
    <Compile Remove="Forms\Interface.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Forms\BrainStimulator_Bkp.resx" />
    <EmbeddedResource Remove="Forms\Interface.resx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialSkin.2" Version="2.3.1" />
    <PackageReference Include="OxyPlot.WindowsForms" Version="2.1.2" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="WinForms.DataVisualization" Version="1.9.2" />
  </ItemGroup>

</Project>